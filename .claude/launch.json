{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/ParkingSubscription.Api", "--no-launch-profile", "--urls", "http://localhost:5024"],
      "port": 5024
    },
    {
      "name": "web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/ParkingSubscription.Web", "--no-launch-profile", "--urls", "http://localhost:5100"],
      "port": 5100
    },
    {
      "name": "admin",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/ParkingSubscription.AdminPanel", "--no-launch-profile", "--urls", "http://localhost:5101"],
      "port": 5101
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "--prefix", "mobile", "--", "--port", "8085"],
      "port": 8085
    }
  ]
}

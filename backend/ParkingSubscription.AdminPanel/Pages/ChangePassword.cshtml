@page
@model ParkingSubscription.AdminPanel.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Зміна пароля";
}
<div class="page-head"><h2>Зміна пароля</h2></div>

<div class="card" style="padding:22px; max-width:420px;">
    <form method="post" class="form">
        <label>Поточний пароль</label>
        <input type="password" asp-for="Current" autocomplete="current-password" />
        <label>Новий пароль</label>
        <input type="password" asp-for="NewPassword" autocomplete="new-password" />
        <label>Повторіть новий пароль</label>
        <input type="password" asp-for="Confirm" autocomplete="new-password" />

        @if (Model.Error != null)
        {
            <div class="error">@Model.Error</div>
        }
        @if (Model.Message != null)
        {
            <div class="ok-msg">@Model.Message</div>
        }
        <button type="submit">Зберегти</button>
    </form>
</div>

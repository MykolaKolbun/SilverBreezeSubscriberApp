@{
    var current = (ViewContext.RouteData.Values["page"] as string) ?? "";
    string Active(string page) => current.Equals(page, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SilverBreeze — Панель керування</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="app">
        <aside class="sidebar">
            <div class="brand">Silver<span class="brand-blue">Breeze</span></div>
            <nav>
                <a asp-page="/Clients" class="@Active("/Clients")">Клієнти</a>
                <a asp-page="/Settings" class="@Active("/Settings")">Налаштування</a>
                <a asp-page="/Reports" class="@Active("/Reports")">Звіти</a>
            </nav>
        </aside>
        <main>
            <header class="topbar">
                <h1>Панель керування</h1>
                <details class="usermenu">
                    <summary title="Адміністратор">
                        <span class="avatar">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="8" r="4" fill="currentColor" />
                                <path d="M4 20c0-3.3 3.6-6 8-6s8 2.7 8 6" fill="currentColor" />
                            </svg>
                        </span>
                        <span class="uname">Адміністратор</span>
                    </summary>
                    <div class="menu">
                        <a asp-page="/ChangePassword">Змінити пароль</a>
                        <form method="post" asp-page="/Logout">
                            <button type="submit">Вийти</button>
                        </form>
                    </div>
                </details>
            </header>
            <section class="content">
                @RenderBody()
            </section>
        </main>
    </div>
</body>
</html>

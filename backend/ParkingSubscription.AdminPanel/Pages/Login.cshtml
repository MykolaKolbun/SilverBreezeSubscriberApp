@page
@model ParkingSubscription.AdminPanel.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SilverBreeze — Вхід</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-body">
    <form method="post" class="login-card">
        <div class="brand center">SilverBreeze</div>
        <div class="muted center" style="margin-bottom:18px;">Панель керування</div>
        <label>Пароль адміністратора</label>
        <input type="password" asp-for="Password" autofocus autocomplete="current-password" />
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="error">@Model.Error</div>
        }
        <button type="submit">Увійти</button>
    </form>
</body>
</html>

@page "{id:guid?}"
@model ParkingSubscription.AdminPanel.Pages.ClientEditModel
@{
    ViewData["Title"] = "Клієнт";
}
<div class="page-head">
    <a asp-page="/Clients" class="muted" style="text-decoration:none;">← Клієнти</a>
    <h2>Редагування клієнта</h2>
</div>

@functions {
    static string StatusLabel(ParkingSubscription.Domain.Enums.CardStatus s) => s switch
    {
        ParkingSubscription.Domain.Enums.CardStatus.Active => "Активний",
        ParkingSubscription.Domain.Enums.CardStatus.Blocked => "Заблокований",
        ParkingSubscription.Domain.Enums.CardStatus.Suspended => "Призупинений",
        _ => "Видалений"
    };
}

<div class="muted" style="margin:-8px 0 16px;">
    ID @Model.Id.ToString()[..8] · @(Model.Email ?? "—")
    @if (Model.HasActiveSubscription) { <span class="badge ok">Активний абонемент</span> } else { <span class="badge">Без абонемента</span> }
</div>

<div class="settings-grid">

    <div class="card sect">
        <h3>Дані користувача</h3>
        <form method="post" asp-page-handler="Save" class="form">
            <label>Ім'я</label>
            <input type="text" asp-for="FirstName" placeholder="—" />
            <label>Прізвище</label>
            <input type="text" asp-for="Surname" placeholder="—" />
            <label>Email</label>
            <input type="text" value="@(Model.Email ?? "")" disabled />
            <div class="muted hint">Email — логін користувача, змінюється лише самим користувачем.</div>
            <label>Мобільний телефон</label>
            <input type="text" asp-for="Mobile" placeholder="+380…" />

            <h3 style="margin-top:18px;">Політика в'їзду за номером</h3>
            <label class="check"><input type="checkbox" asp-for="PassageLp" /> passageLP — в'їзд/виїзд лише за номером</label>
            <label class="check"><input type="checkbox" asp-for="CheckLp" /> checkLP — номер разом із карткою</label>
            <label class="check"><input type="checkbox" asp-for="MatchEntryPlate" /> matchEntryPlate — виїзд тим самим номером</label>

            @if (Model.Saved == "user") { <div class="ok-msg">Збережено.</div> }
            <button type="submit">Зберегти</button>
        </form>
    </div>

    <div class="card sect">
        <h3>Абонементи</h3>
        <div class="muted" style="margin-bottom:12px;">Блокування/призупинення абонемента синхронізуються з паркінгом.</div>
        @if (Model.Saved == "card") { <div class="ok-msg" style="margin-bottom:10px;">Готово.</div> }
        @if (Model.Cards.Count == 0)
        {
            <div class="muted">Немає абонементів.</div>
        }
        else
        {
            <table class="grid">
                <thead><tr><th>Тариф</th><th>Період</th><th>Статус</th><th></th></tr></thead>
                <tbody>
                @foreach (var c in Model.Cards)
                {
                    <tr>
                        <td>@(c.PlanName ?? "—")</td>
                        <td class="mono">@c.StartDate.ToString("yyyy-MM-dd") – @c.EndDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            <span class="badge @(c.Status == ParkingSubscription.Domain.Enums.CardStatus.Active ? "ok" : "")">@StatusLabel(c.Status)</span>
                        </td>
                        <td style="white-space:nowrap;">
                            @switch (c.Status)
                            {
                                case ParkingSubscription.Domain.Enums.CardStatus.Active:
                                    <form method="post" asp-page-handler="CardBlock" asp-route-cardId="@c.Id" style="display:inline;">
                                        <button type="submit" class="btn-sm">Заблокувати</button>
                                    </form>
                                    <form method="post" asp-page-handler="CardSuspend" asp-route-cardId="@c.Id" style="display:inline;">
                                        <button type="submit" class="btn-sm">Призупинити</button>
                                    </form>
                                    break;
                                case ParkingSubscription.Domain.Enums.CardStatus.Blocked:
                                    <form method="post" asp-page-handler="CardUnblock" asp-route-cardId="@c.Id" style="display:inline;">
                                        <button type="submit" class="btn-sm">Розблокувати</button>
                                    </form>
                                    break;
                                case ParkingSubscription.Domain.Enums.CardStatus.Suspended:
                                    <form method="post" asp-page-handler="CardResume" asp-route-cardId="@c.Id" style="display:inline;">
                                        <button type="submit" class="btn-sm">Відновити</button>
                                    </form>
                                    break;
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }

        <h3 style="margin-top:18px;">Автомобілі</h3>
        @if (Model.Vehicles.Count == 0)
        {
            <div class="muted">Немає доданих авто.</div>
        }
        else
        {
            <table class="grid">
                <thead><tr><th>Номер</th><th>Марка</th><th>Модель</th></tr></thead>
                <tbody>
                @foreach (var v in Model.Vehicles)
                {
                    <tr>
                        <td class="mono">@v.PlateNumber</td>
                        <td>@(v.Make ?? "—")</td>
                        <td>@(v.Model ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

</div>

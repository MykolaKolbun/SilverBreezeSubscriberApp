@page
@model ParkingSubscription.AdminPanel.Pages.SettingsModel
@{
    ViewData["Title"] = "Налаштування";
    string Kept(bool has) => has ? "Встановлено. Залиште порожнім, щоб не міняти." : "Не задано.";
}
<div class="page-head"><h2>Налаштування</h2></div>

<div class="settings-grid">

    <div class="card sect">
        <h3>Паркінг</h3>
        <form method="post" asp-page-handler="Parking" class="form">
            <label>Кількість вільних місць для продажу</label>
            <input type="number" min="0" asp-for="ParkingCapacity" placeholder="50" />
            <div class="muted" style="margin:-8px 0 12px;">Максимум одночасно активних абонементів. Порожньо — значення за замовчуванням.</div>
            @if (Model.Saved == "parking") { <div class="ok-msg">Збережено.</div> }
            <button type="submit">Зберегти</button>
        </form>
    </div>

    <div class="card sect">
        <h3>Фіскальний провайдер (Checkbox Online)</h3>
        <form method="post" asp-page-handler="Fiscal" class="form">
            <label>Base URL</label>
            <input type="text" asp-for="FiscalBaseUrl" placeholder="https://api.checkbox.ua" />
            <label>Код податку (TaxCode)</label>
            <input type="number" asp-for="FiscalTaxCode" placeholder="напр. 1" />
            <label>PIN касира</label>
            <input type="password" asp-for="FiscalPin" autocomplete="off" placeholder="••••••" />
            <div class="muted hint">@Kept(Model.FiscalHasPin)</div>
            <label>Ліцензійний ключ</label>
            <input type="password" asp-for="FiscalLicense" autocomplete="off" placeholder="••••••" />
            <div class="muted hint">@Kept(Model.FiscalHasLicense)</div>
            @if (Model.Saved == "fiscal") { <div class="ok-msg">Збережено.</div> }
            <button type="submit">Зберегти</button>
        </form>
    </div>

    <div class="card sect">
        <h3>Оплата (iPay)</h3>
        <form method="post" asp-page-handler="Ipay" class="form">
            <label>Merchant ID</label>
            <input type="text" asp-for="IpayMerchantId" placeholder="mch_id" />
            <label>Base URL</label>
            <input type="text" asp-for="IpayBaseUrl" placeholder="https://checkout.ipay.ua/api302" />
            <label>Sign Key</label>
            <input type="password" asp-for="IpaySignKey" autocomplete="off" placeholder="••••••" />
            <div class="muted hint">@Kept(Model.IpayHasSignKey)</div>
            @if (Model.Saved == "ipay") { <div class="ok-msg">Збережено.</div> }
            <button type="submit">Зберегти</button>
        </form>
    </div>

    <div class="card sect">
        <h3>Паркінг-інтеграція (SKIDATA sweb)</h3>
        <form method="post" asp-page-handler="Skidata" class="form">
            <label class="check"><input type="checkbox" asp-for="SkidataEnabled" /> Увімкнути надсилання абонементів у паркінг</label>
            <label>Base URL</label>
            <input type="text" asp-for="SkidataBaseUrl" placeholder="https://sweb.skidata.com/bei/DTASales/SubscribeApi" />
            <label>Логін (basicAuth)</label>
            <input type="text" asp-for="SkidataUsername" autocomplete="off" placeholder="••••••" />
            <div class="muted hint">@Kept(Model.SkidataHasUsername)</div>
            <label>Пароль (basicAuth)</label>
            <input type="password" asp-for="SkidataPassword" autocomplete="off" placeholder="••••••" />
            <div class="muted hint">@Kept(Model.SkidataHasPassword)</div>
            <label>Facility Number</label>
            <input type="text" asp-for="SkidataFacilityNumber" placeholder="напр. 1" />
            <label>QR Identification — Type</label>
            <input type="text" asp-for="SkidataQrType" placeholder="EXT" />
            <label>QR Identification — SubType (формат штрих-коду)</label>
            <input type="text" asp-for="SkidataQrSubType" placeholder="від SKIDATA (напр. QR_CODE)" />
            <label>Звʼязок user → customer</label>
            <select asp-for="SkidataCustomerLink">
                <option value="b2b">b2bCustomerId</option>
                <option value="group">groupCustomerId</option>
            </select>
            <div class="muted" style="margin:-8px 0 12px;">Яке поле CreateUser привʼязує користувача до клієнта — уточніть у SKIDATA.</div>
            @if (Model.Saved == "skidata") { <div class="ok-msg">Збережено.</div> }
            <button type="submit">Зберегти</button>
        </form>
    </div>

</div>

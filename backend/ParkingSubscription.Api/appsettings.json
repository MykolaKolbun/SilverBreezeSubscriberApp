{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=parking.db"
  },
  "Jwt": {
    "Issuer": "ParkingSubscription",
    "Audience": "ParkingSubscription",
    "SigningKey": "dev-only-signing-key-change-me-please-32bytes-min",
    "AccessTokenMinutes": 30
  },
  "Auth": {
    "ExposeDevTokens": true,
    "RefreshTokenDays": 365,
    "ResetTokenHours": 2
  },
  "Payment": {
    "Provider": "Stub",
    "PublicBaseUrl": "http://localhost:8080",
    "AppReturnUrl": "silverbreeze://payment"
  },
  "Fiscal": {
    "Provider": "Stub"
  }
}

@page
@model IndexModel
@{
    ViewData["Title"] = L["nav.plans"];
    if (Model.LoggedIn && Model.Plans.Count > 0)
    {
        ViewData["MainWide"] = true;
    }
}

@if (Model.Error is not null)
{
    <div class="alert">@Model.Error</div>
}

@if (!Model.LoggedIn)
{
    <h1>@L["index.subsTitle"]</h1>
    <p class="lead">
        @L["index.leadIntro"] <a href="/Login">@L["index.leadLogin"]</a>@L["index.leadTail"]
    </p>
}
else if (Model.Plans.Count == 0)
{
    <h1>@L["index.subsTitle"]</h1>
    <p>@L["index.noPlans"]</p>
}
else
{
    <div class="page-intro">
        <h1>@L["index.choose"]</h1>
        <p class="muted">@L["index.venue"]</p>
    </div>

    <div class="plans">
        @foreach (var plan in Model.Plans)
        {
            var perDay = plan.DurationDays > 0 ? plan.PriceMinor / plan.DurationDays : 0;
            <div class="plan">
                <h3 class="plan-name">@plan.Name</h3>
                <div class="plan-price">@Money.Format(plan.PriceMinor, plan.Currency)</div>
                <div class="plan-per">@Money.Format(perDay, plan.Currency) @L["plan.perDay"]</div>
                <div class="plan-dur">@L.Format("plan.valid", plan.DurationDays)</div>
                <a href="/Buy?planId=@plan.Id" class="button primary plan-buy">@L["plan.buy"]</a>
            </div>
        }
    </div>
}

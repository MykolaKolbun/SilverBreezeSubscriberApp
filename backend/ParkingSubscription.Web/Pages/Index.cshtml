@page
@model IndexModel
@{
    ViewData["Title"] = "Тарифи";
}

<h1>Абонементи на паркінг</h1>

@if (Model.Error is not null)
{
    <div class="alert">@Model.Error</div>
}

@if (!Model.LoggedIn)
{
    <p class="lead">
        Придбайте контрактний паркувальний абонемент, отримайте QR-код і пропуск у гаманець.
        <a href="/Register">Створіть акаунт</a> або <a href="/Login">увійдіть</a>, щоб побачити тарифи.
    </p>
}
else if (Model.Plans.Count == 0)
{
    <p>Наразі активних тарифів немає.</p>
}
else
{
    <div class="cards">
        @foreach (var plan in Model.Plans)
        {
            <div class="card">
                <h2>@plan.Name</h2>
                <p class="price">@Money.Format(plan.PriceMinor, plan.Currency)</p>
                <p class="muted">Діє @plan.DurationDays днів</p>
                <form method="post">
                    <input type="hidden" name="planId" value="@plan.Id" />
                    <button type="submit" class="primary">Придбати</button>
                </form>
            </div>
        }
    </div>
}

@page
@model ConfirmModel
@{
    ViewData["Title"] = "Підтвердження email";
}

<h1>Підтвердіть email</h1>

<p class="muted">
    Код підтвердження надіслано на вашу пошту.
    @if (Model.Token is not null)
    {
        <text>(Режим розробки: код підставлено автоматично.)</text>
    }
</p>

@if (Model.Error is not null)
{
    <div class="alert">@Model.Error</div>
}

<form method="post" class="form">
    <label>Email <input type="email" name="email" value="@Model.Email" required /></label>
    <label>Код підтвердження <input type="text" name="token" value="@Model.Token" required /></label>
    <button type="submit" class="primary">Підтвердити</button>
</form>

@page
@model BuyModel
@{
    ViewData["Title"] = L["buy.title"];
}

<h1>@L["buy.h1"]</h1>

@if (Model.Error is not null)
{
    <div class="alert">@Model.Error</div>
}

@if (Model.Plan is { } plan)
{
    <div class="panel buy-summary">
        <h3>@plan.Name</h3>
        <p class="price">@Money.Format(plan.PriceMinor, plan.Currency)</p>
        <p class="muted">@L.Format("plan.valid", plan.DurationDays)</p>
    </div>

    <form method="post" class="form">
        <label>@L["buy.startLabel"]
            <input type="date" asp-for="StartDate"
                   min="@Model.MinStart.ToString("yyyy-MM-dd")" required />
        </label>
        <p class="muted">@L.Format("buy.notBefore", Model.MinStart.ToString("dd.MM.yyyy"))</p>
        <p class="muted">@L["buy.period"]: <strong>@Model.StartDate.ToString("dd.MM.yyyy") – @Model.EndDate.ToString("dd.MM.yyyy")</strong></p>
        <button type="submit" class="primary">@L["buy.toPay"]</button>
        <a href="/" class="link-button" style="margin-top:8px;">@L["buy.back"]</a>
    </form>
}

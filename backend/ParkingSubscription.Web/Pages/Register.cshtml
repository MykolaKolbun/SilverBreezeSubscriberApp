@page
@model RegisterModel
@{
    ViewData["Title"] = "Реєстрація";
}

<h1>Створення акаунта</h1>

@if (Model.Error is not null)
{
    <div class="alert">@Model.Error</div>
}

<form method="post" class="form">
    <label>Email <input type="email" name="email" value="@Model.Email" required /></label>
    <label>Пароль (мінімум 8 символів) <input type="password" name="password" minlength="8" required /></label>
    <label>Імʼя <input type="text" name="firstName" /></label>
    <label>Прізвище <input type="text" name="surname" /></label>
    <button type="submit" class="primary">Зареєструватися</button>
</form>

<p class="muted">Вже маєте акаунт? <a href="/Login">Увійти</a></p>

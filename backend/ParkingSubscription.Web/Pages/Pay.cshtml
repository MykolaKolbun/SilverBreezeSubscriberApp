@page
@model PayModel
@{
    ViewData["Title"] = "Оплата";
}

<h1>Оплата</h1>

@if (Model.Error is not null)
{
    <div class="alert">@Model.Error</div>
}

@if (Model.Payment is { } p)
{
    <div class="panel">
        <p><strong>Сума:</strong> @Money.Format(p.AmountMinor, p.Currency)</p>
        <p><strong>Статус:</strong> <span class="status status-@p.Status.ToLower()">@p.Status</span></p>
        @if (p.FailureReason is not null)
        {
            <p class="muted">@p.FailureReason</p>
        }
    </div>

    @if (p.Status == "Pending")
    {
        <p class="muted">
            Реальний платіжний провайдер ще не підключений. У режимі розробки ви граєте його роль —
            оберіть, чим завершиться оплата:
        </p>
        <form method="post" class="inline-form">
            <input type="hidden" name="paymentId" value="@Model.PaymentId" />
            <input type="hidden" name="provider" value="@Model.Provider" />
            <button type="submit" name="outcome" value="succeeded" class="primary">✔ Симулювати успішну оплату</button>
            <button type="submit" name="outcome" value="declined" class="danger">✖ Симулювати відмову</button>
        </form>
    }
    else if (p.Status == "Succeeded")
    {
        <div class="success">
            Оплату завершено — ваш абонемент активний.
            @if (p.FiscalReceiptId is not null)
            {
                <br /><small>Фіскальний чек: @p.FiscalReceiptId</small>
            }
        </div>
        <p><a class="button primary" href="/Cards">Перейти до мого пропуску →</a></p>
    }
}

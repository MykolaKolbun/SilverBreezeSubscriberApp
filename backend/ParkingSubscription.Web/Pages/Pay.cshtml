@page
@model PayModel
@{
    ViewData["Title"] = L["pay.title"];
}

<h1>@L["pay.title"]</h1>

@if (Model.Error is not null)
{
    <div class="alert">@Model.Error</div>
}

@if (Model.Payment is { } p)
{
    <div class="panel">
        <p><strong>@L["pay.amount"]:</strong> @Money.Format(p.AmountMinor, p.Currency)</p>
        <p><strong>@L["pay.status"]:</strong> <span class="status status-@p.Status.ToLower()">@L.Status(p.Status)</span></p>
        @if (p.FailureReason is not null)
        {
            <p class="muted">@p.FailureReason</p>
        }
    </div>

    @if (p.Status == "Succeeded")
    {
        <div class="success">
            @L["pay.done"]
            @if (p.FiscalReceiptId is not null)
            {
                <br /><small>@L["pay.receipt"]: @p.FiscalReceiptId</small>
            }
        </div>
        <p><a class="button primary" href="/Cards">@L["pay.toPass"]</a></p>
    }
    else if (p.Status == "Pending")
    {
        <p class="muted">@L["pay.processing"]</p>
        <p><a class="button" href="/Pay?paymentId=@Model.PaymentId">@L["pay.refresh"]</a></p>
    }
    else
    {
        <div class="alert">@L["pay.failed"]</div>
        <p><a class="button primary" href="/">@L["pay.choose"]</a></p>
    }
}

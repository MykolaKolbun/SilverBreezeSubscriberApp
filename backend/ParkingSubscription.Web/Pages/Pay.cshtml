@page
@model PayModel
@{
    ViewData["Title"] = "Оплата";
}
@functions {
    static string StatusLabel(string s) => s.ToLower() switch
    {
        "succeeded" => "Успішно",
        "pending" => "Обробляється",
        "declined" => "Відхилено",
        "failed" => "Помилка",
        "timedout" => "Час вичерпано",
        "refunded" => "Повернено",
        _ => s
    };
}

<h1>Оплата</h1>

@if (Model.Error is not null)
{
    <div class="alert">@Model.Error</div>
}

@if (Model.Payment is { } p)
{
    <div class="panel">
        <p><strong>Сума:</strong> @Money.Format(p.AmountMinor, p.Currency)</p>
        <p><strong>Статус:</strong> <span class="status status-@p.Status.ToLower()">@StatusLabel(p.Status)</span></p>
        @if (p.FailureReason is not null)
        {
            <p class="muted">@p.FailureReason</p>
        }
    </div>

    @if (p.Status == "Succeeded")
    {
        <div class="success">
            Оплату завершено — ваш абонемент активний.
            @if (p.FiscalReceiptId is not null)
            {
                <br /><small>Фіскальний чек: @p.FiscalReceiptId</small>
            }
        </div>
        <p><a class="button primary" href="/Cards">Перейти до мого пропуску →</a></p>
    }
    else if (p.Status == "Pending")
    {
        <p class="muted">Оплата ще обробляється. Оновіть статус за кілька секунд.</p>
        <p><a class="button" href="/Pay?paymentId=@Model.PaymentId">Оновити статус</a></p>
    }
    else
    {
        <div class="alert">Оплату не завершено.</div>
        <p><a class="button primary" href="/">Обрати абонемент</a></p>
    }
}

@page
@model HistoryModel
@{
    ViewData["Title"] = L["nav.history"];
}

<h1>@L["history.title"]</h1>

@if (Model.Error is not null)
{
    <div class="alert">@Model.Error</div>
}

@if (Model.Payments.Count == 0 && Model.Error is null)
{
    <p class="muted">@L["history.empty"]</p>
}

<div class="hist">
    @foreach (var p in Model.Payments)
    {
        <div class="hist-row">
            <div class="hist-main">
                <div class="hist-amount">@Money.Format(p.AmountMinor, p.Currency)</div>
                <div class="muted">@p.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
            </div>
            <span class="status status-@p.Status.ToLower()">@L.Status(p.Status)</span>
            <div class="hist-actions">
                @if (p.FiscalReceiptId is not null)
                {
                    <a class="link-button" href="?handler=ReceiptPng&paymentId=@p.Id" target="_blank" rel="noopener">@L["history.receipt"]</a>
                    <a class="link-button" href="?handler=ReceiptPdf&paymentId=@p.Id">@L["history.pdf"]</a>
                }
            </div>
        </div>
    }
</div>

@page
@model HistoryModel
@{
    ViewData["Title"] = "Історія";
}
@functions {
    static string StatusLabel(string s) => s.ToLower() switch
    {
        "succeeded" => "Успішно",
        "pending" => "Обробляється",
        "declined" => "Відхилено",
        "failed" => "Помилка",
        "timedout" => "Час вичерпано",
        "refunded" => "Повернено",
        _ => s
    };
}

<h1>Історія платежів</h1>

@if (Model.Error is not null)
{
    <div class="alert">@Model.Error</div>
}

@if (Model.Payments.Count == 0 && Model.Error is null)
{
    <p class="muted">Платежів ще немає.</p>
}

<div class="hist">
    @foreach (var p in Model.Payments)
    {
        <div class="hist-row">
            <div class="hist-main">
                <div class="hist-amount">@Money.Format(p.AmountMinor, p.Currency)</div>
                <div class="muted">@p.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
            </div>
            <span class="status status-@p.Status.ToLower()">@StatusLabel(p.Status)</span>
            <div class="hist-actions">
                @if (p.FiscalReceiptId is not null)
                {
                    <a class="link-button" href="?handler=ReceiptPng&paymentId=@p.Id" target="_blank" rel="noopener">Чек</a>
                    <a class="link-button" href="?handler=ReceiptPdf&paymentId=@p.Id">PDF</a>
                }
            </div>
        </div>
    }
</div>

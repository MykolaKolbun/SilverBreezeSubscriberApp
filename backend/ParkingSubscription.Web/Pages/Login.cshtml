@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<h1>Log in</h1>

@if (Model.Confirmed)
{
    <div class="success">Email confirmed — you can log in now.</div>
}
@if (Model.Error is not null)
{
    <div class="alert">@Model.Error</div>
}

<form method="post" class="form">
    <label>Email <input type="email" name="email" value="@Model.Email" required /></label>
    <label>Password <input type="password" name="password" required /></label>
    <button type="submit" class="primary">Log in</button>
</form>

<p class="muted">No account yet? <a href="/Register">Register</a></p>

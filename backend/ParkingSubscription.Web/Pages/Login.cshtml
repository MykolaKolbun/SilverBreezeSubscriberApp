@page
@model LoginModel
@{
    ViewData["Title"] = "Увійти";
}

<h1>Вхід</h1>

@if (Model.Confirmed)
{
    <div class="success">Email підтверджено — тепер можна увійти.</div>
}
@if (Model.Error is not null)
{
    <div class="alert">@Model.Error</div>
}

<form method="post" class="form">
    <label>Email <input type="email" name="email" value="@Model.Email" required /></label>
    <label>Пароль <input type="password" name="password" required /></label>
    <button type="submit" class="primary">Увійти</button>
</form>

<p class="muted">Ще немає акаунта? <a href="/Register">Зареєструватися</a></p>

@page
@model LoginModel
@{
    ViewData["Title"] = L["login.title"];
}

<h1>@L["login.title"]</h1>

@if (Model.Error is not null)
{
    <div class="alert">@Model.Error</div>
}

@if (!Model.CodeSent)
{
    <form method="post" asp-page-handler="Request" class="form">
        <label>@L["common.email"]
            <input type="email" asp-for="Email" autocomplete="email" required autofocus />
        </label>
        <button type="submit" class="primary">@L["login.getCode"]</button>
    </form>
    <p class="muted">@L["login.hint"]</p>
}
else
{
    <form method="post" asp-page-handler="Verify" class="form">
        <input type="hidden" asp-for="Email" />
        <label>@L["login.codeLabel"]
            <input type="text" asp-for="Code" value="@Model.DevCode" inputmode="numeric"
                   autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" required autofocus />
        </label>
        <button type="submit" class="primary">@L["login.signIn"]</button>
    </form>
    <p class="muted">@L["login.sentTo"] <strong>@Model.Email</strong>.</p>
    @if (Model.DevCode is not null)
    {
        <p class="muted">@L["login.devCode"]</p>
    }
    <form method="post" asp-page-handler="Request" class="inline-form">
        <input type="hidden" asp-for="Email" />
        <button type="submit" class="link-button">@L["login.resend"]</button>
    </form>
}

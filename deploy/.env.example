# Copy to `.env` on the Raspberry Pi (never commit the real .env).
# The GitHub Actions deploy job regenerates this file from repository secrets.

# --- Database ---
DB_NAME=SWeb_DB
DB_USER=parking
DB_PASSWORD=change-me-strong-password

# --- JWT ---
# Use a long random string (>= 32 bytes), e.g.:  openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-secret

# --- iPay payment gateway ---
# Merchant id (mch_id) — not secret. SignKey — SECRET, keep only here on the Pi.
# On first boot after these are set, the SignKey is encrypted and stored in the DB.
IPAY_MCH_ID=
IPAY_SIGN_KEY=
# Sandbox by default; switch to https://checkout.ipay.ua/api302 for production.
IPAY_BASE_URL=https://sandbox-checkout.ipay.ua/api302

# --- Checkbox Online fiscalization ---
# Cashier PIN and license key are SECRETS — keep only here on the Pi.
CHECKBOX_PIN=
CHECKBOX_LICENSE_KEY=
CHECKBOX_BASE_URL=https://api.checkbox.ua
# Checkbox tax-rate code for the parking good (blank = no tax line).
CHECKBOX_TAX_CODE=

# --- Admin panel ---
# INITIAL admin password (seeded to the DB on first use; afterwards change it in the
# panel's Settings — the DB value wins over this).
ADMIN_PASSWORD=Passw0rd

# --- Subscription limits ---
# Venue-wide cap on concurrently active subscriptions (parking capacity).
MAX_ACTIVE_SUBSCRIPTIONS=50

# --- SKIDATA sweb(R) Subscribe API (parking integration) ---
# Leave BaseUrl/USERNAME/PASSWORD/FACILITY blank to keep the logging stub (no push
# to the parking system). Fill all four to enable real propagation via the outbox.
# USERNAME/PASSWORD are basicAuth SECRETS — keep only here on the Pi.
SKIDATA_BASE_URL=
SKIDATA_USERNAME=
SKIDATA_PASSWORD=
# Car-park / facility number (path parameter on all card endpoints).
SKIDATA_FACILITY_NUMBER=
# Product UUIDs provided by SKIDATA for the parking product (and optional value card).
SKIDATA_PARKING_PRODUCT_ID=
SKIDATA_VALUE_PRODUCT_ID=
# QR identification mapping — must match the GenericIdentification config on the product.
SKIDATA_QR_ID_TYPE=EXT
SKIDATA_QR_ID_SUBTYPE=
# Which CreateUser field links a user to its customer: b2b (default) or group.
SKIDATA_CUSTOMER_LINK_FIELD=b2b

# --- API image (optional) ---
# Defaults to ghcr.io/mykolakolbun/parkingsubscription-api:latest if unset.
# API_IMAGE=ghcr.io/mykolakolbun/parkingsubscription-api:latest

# Copy to `.env` on the Raspberry Pi (never commit the real .env).
# The GitHub Actions deploy job regenerates this file from repository secrets.

# --- Database ---
DB_NAME=SWeb_DB
DB_USER=parking
DB_PASSWORD=change-me-strong-password

# --- JWT ---
# Use a long random string (>= 32 bytes), e.g.:  openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-secret

# --- iPay payment gateway ---
# Merchant id (mch_id) — not secret. SignKey — SECRET, keep only here on the Pi.
# On first boot after these are set, the SignKey is encrypted and stored in the DB.
IPAY_MCH_ID=
IPAY_SIGN_KEY=
# Sandbox by default; switch to https://checkout.ipay.ua/api302 for production.
IPAY_BASE_URL=https://sandbox-checkout.ipay.ua/api302

# --- API image (optional) ---
# Defaults to ghcr.io/mykolakolbun/parkingsubscription-api:latest if unset.
# API_IMAGE=ghcr.io/mykolakolbun/parkingsubscription-api:latest

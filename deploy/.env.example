# Copy to `.env` on the Raspberry Pi (never commit the real .env).
# The GitHub Actions deploy job regenerates this file from repository secrets.

# --- Database ---
DB_NAME=SWeb_DB
DB_USER=parking
DB_PASSWORD=change-me-strong-password

# --- JWT ---
# Use a long random string (>= 32 bytes), e.g.:  openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-secret

# --- Payment gateway (iPay) & fiscalization (Checkbox Online) ---
# Configured from the AdminPanel (Налаштування → Оплата / Фіскальний провайдер),
# NOT here. Merchant id, base URLs, sign key, PIN and license key are all stored
# in the DB, secrets encrypted with the shared Data Protection keys.

# --- Admin panel ---
# INITIAL admin password (seeded to the DB on first use; afterwards change it in the
# panel's Settings — the DB value wins over this).
ADMIN_PASSWORD=Passw0rd

# --- Subscription limits ---
# Venue-wide cap on concurrently active subscriptions (parking capacity).
MAX_ACTIVE_SUBSCRIPTIONS=50

# --- SKIDATA sweb(R) Subscribe API (parking integration) ---
# Configured from the AdminPanel (Налаштування → Паркінг-інтеграція), NOT here.
# basicAuth credentials are encrypted at rest with the shared Data Protection keys.

# --- API image (optional) ---
# Defaults to ghcr.io/mykolakolbun/parkingsubscription-api:latest if unset.
# API_IMAGE=ghcr.io/mykolakolbun/parkingsubscription-api:latest
